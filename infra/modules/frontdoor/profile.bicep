// Managed Front Door profile of ONE environment (ADR-0010, frontDoor.mode: managed):
// profile afd-{prefix}-{env}, endpoint fde-{prefix}-{env}, WAF policy waf{prefix}{env} bound to
// the endpoint by a security policy. Tier and WAF come from the environment's
// frontDoor.managed.profiles entry or the defaults of its kind (resolved by the caller).
//
// Per-app origin groups, origins, routes and custom domains are not created here:
// infra/app/frontdoor.bicep (app-route.bicep) adds them, one deployment per app. A WAF policy can
// be linked through only one security policy per profile (sandbox, 2026-11-01), so app custom
// domains can only join this policy's associations, and they don't yet: open decision in ADR-0010
// (amended 2026-11-01). If they are added, a PUT replaces the whole association list.
// The portal identity gets Reader on this profile only (not the platform RG), so the portal shows
// the apps' custom domains, routes and the endpoint (ADR-0010, amended 2026-11-01).
// Verify in sandbox: FD-5 (profile per environment), FD-6 (cost), NR-2 (name limits), FD-7 (the
// portal reads the custom domains with Reader on the profile).

import { builtInRoles } from '../types.bicep'

@description('Profile name (naming.frontDoorProfile).')
param profileName string

@description('Endpoint name (naming.frontDoorEndpoint).')
param endpointName string

@description('WAF policy name (naming.frontDoorWafPolicy).')
param wafPolicyName string

@description('Security policy name (naming.frontDoorSecurityPolicy).')
param securityPolicyName string

@allowed([
  'Standard'
  'Premium'
])
param sku string

@description('off = no WAF policy; detection logs only; prevention blocks.')
@allowed([
  'off'
  'detection'
  'prevention'
])
param wafMode string

@description('Managed rule sets (Default Rule Set, Bot Manager). Premium only.')
param managedRuleSets bool

@description('Environment Log Analytics workspace.')
param workspaceId string

@description('Diagnostic setting name (naming.diagnosticSetting).')
param diagnosticSettingName string

param tags object

@description('Object (principal) ID of the portal identity id-{prefix}-portal: Reader on this profile only, for the custom domains in the portal (ADR-0010, amended 2026-11-01). Empty = no assignment (the portal is not set up yet).')
param portalPrincipalId string

var skuName = sku == 'Premium' ? 'Premium_AzureFrontDoor' : 'Standard_AzureFrontDoor'

// Rule set versions: TODO(verify) the current DRS / Bot Manager versions when FD-5 runs.
var managedRuleSetList = managedRuleSets
  ? [
      {
        ruleSetType: 'Microsoft_DefaultRuleSet'
        ruleSetVersion: '2.1'
        ruleSetAction: 'Block'
      }
      {
        ruleSetType: 'Microsoft_BotManagerRuleSet'
        ruleSetVersion: '1.1'
      }
    ]
  : []

resource profile 'Microsoft.Cdn/profiles@2025-04-15' = {
  name: profileName
  location: 'global'
  tags: tags
  sku: {
    name: skuName
  }
  properties: {
    originResponseTimeoutSeconds: 60
  }
}

resource endpoint 'Microsoft.Cdn/profiles/afdEndpoints@2025-04-15' = {
  parent: profile
  name: endpointName
  location: 'global'
  tags: tags
  properties: {
    enabledState: 'Enabled'
    // The host name gets a hash suffix; it is read from the resource, never built by hand.
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
  }
}

resource wafPolicy 'Microsoft.Network/FrontDoorWebApplicationFirewallPolicies@2025-03-01' = if (wafMode != 'off') {
  name: wafPolicyName
  location: 'global'
  tags: tags
  sku: {
    name: skuName
  }
  properties: {
    policySettings: {
      enabledState: 'Enabled'
      mode: wafMode == 'prevention' ? 'Prevention' : 'Detection'
      requestBodyCheck: 'Enabled'
    }
    // Custom rules (rate limits, geo, IP lists) are tuned per environment later (US08.10).
    customRules: {
      rules: []
    }
    managedRules: {
      managedRuleSets: managedRuleSetList
    }
  }
}

resource securityPolicy 'Microsoft.Cdn/profiles/securityPolicies@2025-04-15' = if (wafMode != 'off') {
  parent: profile
  name: securityPolicyName
  properties: {
    parameters: {
      type: 'WebApplicationFirewall'
      wafPolicy: {
        id: wafPolicy.id
      }
      associations: [
        {
          domains: [
            {
              id: endpoint.id
            }
          ]
          patternsToMatch: [
            '/*'
          ]
        }
      ]
    }
  }
}

// 2021-05-01-preview is the newest diagnosticSettings version with workspace/category groups.
#disable-next-line use-recent-api-versions
resource diagnostics 'Microsoft.Insights/diagnosticSettings@2021-05-01-preview' = {
  name: diagnosticSettingName
  scope: profile
  properties: {
    workspaceId: workspaceId
    logAnalyticsDestinationType: 'Dedicated'
    logs: [
      {
        categoryGroup: 'allLogs'
        enabled: true
      }
    ]
  }
}

// Reader (built-in, types.builtInRoles) on the profile only: the portal reads custom domains
// (validation and certificate state), routes and the endpoint host. It can't change them.
var readerRoleId = subscriptionResourceId('Microsoft.Authorization/roleDefinitions', builtInRoles.reader)

resource portalReader 'Microsoft.Authorization/roleAssignments@2022-04-01' = if (!empty(portalPrincipalId)) {
  // The portal identity lives in the host environment's subscription: its object ID seeds the name.
  name: guid(profile.id, portalPrincipalId, readerRoleId)
  scope: profile
  properties: {
    principalId: portalPrincipalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: readerRoleId
    description: 'Portal: custom domains, routes and endpoint of the apps behind Front Door (ADR-0010).'
  }
}

output profileId string = profile.id
@description('Expected X-Azure-FDID of this environment (injected into apps behind Front Door).')
output frontDoorId string = profile.properties.frontDoorId
output endpointHostName string = endpoint.properties.hostName
