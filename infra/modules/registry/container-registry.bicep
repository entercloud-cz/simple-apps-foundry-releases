// An Azure Container Registry, Basic: an app's own registry (ADR-0004), or an environment's
// platform registry for the core jobs image (ADR-0035, environment.bicep). Same settings for both.
//
// - Permission mode pinned EXPLICITLY to repository permissions (ABAC) mode, and roles are
//   assigned without repository conditions, so assignments act like plain RBAC on a registry
//   that holds one app. AcrPull/AcrPush are not honoured in this mode; the runtime gets
//   Container Registry Repository Reader, the build delivery identity Repository Writer.
// - Domain name label scope pinned to TenantReuse, so the login server carries a hash suffix
//   (`{name}-{16 chars}.azurecr.io`). Never build the login server by hand: read
//   properties.loginServer (output below).
// - No admin user, no anonymous pull. Basic has no network rules: public endpoint, RBAC only.
//
// API version: the GA 2025-11-01 API rejects autoGeneratedDomainNameLabelScope
// (AutoGeneratedDomainNameLabelScopeUnsupportedApiVersion), so this module uses a preview API
// that has it (sandbox check ACR-1, 2026-10-28). Reads with 2025-11-01 return the scope as null;
// the registry keeps it. Without the mode property a new registry gets
// LegacyRegistryPermissions, so the mode stays explicit.
//
// Verify in sandbox: ACR-2, ACR-3.

@description('Registry name (naming.containerRegistry or naming.platformContainerRegistry).')
param name string

@description('Azure region.')
param location string

param tags object

resource registry 'Microsoft.ContainerRegistry/registries@2026-03-01-preview' = {
  name: name
  location: location
  tags: tags
  sku: {
    name: 'Basic'
  }
  properties: {
    adminUserEnabled: false
    anonymousPullEnabled: false
    publicNetworkAccess: 'Enabled'
    roleAssignmentMode: 'AbacRepositoryPermissions'
    // Immutable after creation: a registry created without it must be re-created (ADR-0004).
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
  }
}

output id string = registry.id
output name string = registry.name
output loginServer string = registry.properties.loginServer
