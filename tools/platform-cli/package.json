{
  "name": "@simple-apps-foundry/platform-cli",
  "version": "0.2.0-rc.11",
  "description": "platform CLI: checks, schema validation and agent-file sync for SAF app repos",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./explanations": {
      "types": "./dist/src/explanations.d.ts",
      "default": "./dist/src/explanations.js"
    },
    "./maintenance": {
      "types": "./dist/src/maintenance.d.ts",
      "default": "./dist/src/maintenance.js"
    },
    "./capacity": {
      "types": "./dist/src/capacity.d.ts",
      "default": "./dist/src/capacity.js"
    },
    "./decommission": {
      "types": "./dist/src/decommission.d.ts",
      "default": "./dist/src/decommission.js"
    },
    "./network-change": {
      "types": "./dist/src/network-change.d.ts",
      "default": "./dist/src/network-change.js"
    },
    "./network-request": {
      "types": "./dist/src/network-request.d.ts",
      "default": "./dist/src/network-request.js"
    },
    "./onboarding": {
      "types": "./dist/src/onboarding/index.d.ts",
      "default": "./dist/src/onboarding/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "platform": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/schemas",
    "dist/templates",
    "README.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-schemas.mjs",
    "test": "npm run build && node --test --test-reporter=spec \"dist/test/**/*.test.js\"",
    "demo:good-app": "node scripts/demo.mjs good-app",
    "demo:bad-app": "node scripts/demo.mjs bad-app"
  },
  "dependencies": {
    "@azure/msal-node": "7.2.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "playwright-core": "1.65.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
