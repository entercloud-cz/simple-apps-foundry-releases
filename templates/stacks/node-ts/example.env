# Local development settings. Copy to .env (never commit .env):
#   cp example.env .env
# On Azure these values come from the platform and platform.yaml, not from a file.

LOG_LEVEL=debug

# Pretend to be signed in (there is no platform sign-in on your laptop).
# Ignored when the header is present; refused on Azure.
# DEV_FAKE_ROLES: comma-separated role values from .platform/roles.json; each gives its level
# (read, write or admin). Empty: a user without a role, who sees the "no role yet" page.
DEV_FAKE_USER=dev@contoso.com
DEV_FAKE_ROLES=Admin

# Optional local PostgreSQL, e.g.:
#   docker run --rm -e POSTGRES_PASSWORD=localdev -p 5432:5432 postgres:17.6
# DATABASE_HOST=localhost
# DATABASE_NAME=postgres
# DATABASE_USER=postgres
# DATABASE_PASSWORD=localdev

# Or Azure SQL: the app's nonprod database after `az login`, if your account was given access
# (the server allows Entra sign-in only; no DATABASE_USER, no password):
# DATABASE_HOST=<server>.database.windows.net
# DATABASE_NAME=<database>
