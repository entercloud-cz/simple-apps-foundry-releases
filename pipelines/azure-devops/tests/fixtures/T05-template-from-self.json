{
  "rule": "T05",
  "description": "Including a template from platform-config (self) is rejected.",
  "patches": [
    {
      "file": "templates/stages/verify.yml",
      "find": "          - template: ../steps/platform-cli.yml\n",
      "replace": "          - template: apps/demo/extra.yml@self\n"
    }
  ]
}
