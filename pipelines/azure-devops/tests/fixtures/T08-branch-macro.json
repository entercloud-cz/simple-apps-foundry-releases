{
  "rule": "T08",
  "description": "An untrusted macro in script text is rejected.",
  "patches": [
    {
      "file": "templates/stages/verify.yml",
      "find": "          - bash: bash \"$PIPELINE_WORKSPACE/s/core/pipelines/azure-devops/scripts/release-manifest.sh\" decide\n",
      "replace": "          - bash: echo \"$(Build.SourceBranch)\" && bash \"$PIPELINE_WORKSPACE/s/core/pipelines/azure-devops/scripts/release-manifest.sh\" decide\n"
    }
  ]
}
