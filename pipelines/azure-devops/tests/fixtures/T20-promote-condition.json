{
  "rule": "T20",
  "description": "A promotion stage on the build-branch condition (any deploy.branches branch to prod) is rejected.",
  "patches": [
    {
      "file": "templates/stages/promote.yml",
      "find": "    condition: and(succeeded(), eq(dependencies.verify.outputs['scan.decide.promote'], 'true'))\n",
      "replace": "    condition: and(succeeded(), eq(dependencies.verify.outputs['scan.decide.deployBuildEnvironments'], 'true'))\n"
    }
  ]
}
