{
  "rule": "T08",
  "description": "A resources.repositories macro in script text is rejected.",
  "patches": [
    {
      "file": "templates/stages/verify.yml",
      "find": "          - bash: bash \"$PIPELINE_WORKSPACE/s/core/pipelines/azure-devops/scripts/prepare.sh\"\n",
      "replace": "          - bash: echo $(resources.repositories.app.ref) && bash \"$PIPELINE_WORKSPACE/s/core/pipelines/azure-devops/scripts/prepare.sh\"\n"
    }
  ]
}
