{
  "rule": "P17",
  "description": "The Graph token is masked before it is stored.",
  "patches": [
    {
      "file": "scripts/provisioning/prov-lib.sh",
      "find": "  echo \"##vso[task.setsecret]$token\"\n  SAF_GRAPH_TOKEN=\"$token\"\n",
      "replace": "  SAF_GRAPH_TOKEN=\"$token\"\n"
    }
  ]
}
