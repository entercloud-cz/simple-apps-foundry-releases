{
  "rule": "T29",
  "description": "Downloading another run's artifacts outside stage source is rejected.",
  "patches": [
    {
      "file": "templates/stages/deploy.yml",
      "find": "                      buildType: current\n                      artifactName: image\n",
      "replace": "                      buildType: specific\n                      artifactName: image\n"
    }
  ]
}
