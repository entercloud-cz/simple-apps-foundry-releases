{
  "rule": "T24",
  "description": "A preview that names the wrong source environment is rejected.",
  "patches": [
    {
      "file": "templates/stages/preview.yml",
      "find": "              SAF_PROMOTE_FROM: ${{ parameters.environment.promoteFrom }}\n",
      "replace": "              SAF_PROMOTE_FROM: ${{ parameters.environment.name }}\n"
    }
  ]
}
