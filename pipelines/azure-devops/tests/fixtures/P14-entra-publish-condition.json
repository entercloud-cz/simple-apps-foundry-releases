{
  "rule": "P14",
  "description": "Stage entra publishes its statuses and client IDs after a failure or timeout too (always()).",
  "patches": [
    {
      "file": "templates/provisioning/stages/entra.yml",
      "find": "            displayName: Publish entra\n            condition: always()\n",
      "replace": "            displayName: Publish entra\n            condition: succeededOrFailed()\n"
    }
  ]
}
