{
  "rule": "T25",
  "description": "A build environment deployed in import mode is rejected.",
  "patches": [
    {
      "file": "templates/stages/deploy.yml",
      "find": "                    SAF_ENV_NAME: ${{ parameters.environment.name }}\n",
      "replace": "                    SAF_ENV_NAME: ${{ parameters.environment.name }}\n                    SAF_PROMOTE_FROM: ${{ parameters.environment.name }}\n"
    }
  ]
}
