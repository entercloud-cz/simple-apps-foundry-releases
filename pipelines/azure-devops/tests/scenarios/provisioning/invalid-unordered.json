{
  "description": "prod listed before its source.",
  "entry": "app-provisioning.yml",
  "parameters": {
    "environments": [
      {
        "name": "prod",
        "kind": "prod",
        "promoteFrom": "nonprod"
      },
      {
        "name": "nonprod",
        "kind": "nonprod",
        "promoteFrom": ""
      }
    ],
    "hostEnvironment": "nonprod",
    "scope": "changed",
    "upgrade": "none"
  },
  "expect": {
    "errors": [
      "promoteFrom must name an environment listed earlier"
    ]
  }
}
